# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=REDACTED_TOKEN

# ID de la aplicación (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=REDACTED_CLIENT_ID

# ID del canal donde se publicarán las notas nuevas
CHANNEL_ID=REDACTED_CHANNEL_ID

# ID del servidor (opcional). Si lo pones, los comandos aparecen al instante.
# Si lo dejas vacío, se registran globalmente y tardan hasta 1 hora en aparecer.
GUILD_ID=REDACTED_GUILD_ID

# Cada cuántos minutos revisar si hay notas nuevas
CHECK_INTERVAL_MINUTES=30
